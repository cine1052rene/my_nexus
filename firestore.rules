rules_version = '2';

// MyNexus Firestore 보안 규칙
//
// 모든 사용자 데이터는 users/{userId}/ 하위에 격리된다.
// 이전 구조에서는 links·events·video_clips·settings가 최상위 전역
// 컬렉션이었고 규칙이 `request.auth != null`만 검사해서, 로그인한
// 사용자라면 누구나 다른 사람의 데이터를 읽고 쓸 수 있었다.
// 다중 사용자 배포에서는 곧바로 데이터 유출이므로 경로 기반
// 소유권 검사로 전환했다.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── 과금 관련 필드 보호 ────────────────────────────────
    // isPremium / dailyUsage / lastUsageDate 는 callGemini 함수가
    // Admin SDK(규칙 우회)로만 쓴다. 클라이언트가 이 필드를 건드릴 수
    // 있으면 `isPremium: true` 한 줄로 일일 한도가 통째로 무력화되고
    // Vertex AI 비용이 무제한으로 새어나간다.
    function billingFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isPremium', 'dailyUsage', 'lastUsageDate',
                   'monthlyUsage', 'lastUsageMonth']);
    }

    // 최초 문서 생성 시에는 무료 기본값만 허용한다.
    function billingFieldsAreDefault() {
      return request.resource.data.get('isPremium', false) == false
          && request.resource.data.get('dailyUsage', 0) == 0
          && request.resource.data.get('lastUsageDate', '') == ''
          && request.resource.data.get('monthlyUsage', 0) == 0
          && request.resource.data.get('lastUsageMonth', '') == '';
    }

    // ── 사용자 문서 + 모든 하위 데이터 ──────────────────────
    // links / events / video_clips / settings 는 전부 이 아래에 있다.
    // 와일드카드 하위 매칭이라 새 서브컬렉션을 추가해도 자동으로 보호된다.
    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId) && billingFieldsAreDefault();
      allow update: if isOwner(userId) && billingFieldsUnchanged();

      // 문서 삭제는 클라이언트에 열어주지 않는다. 삭제만 할 수 있어도
      // 사용량 카운터를 0으로 되돌려 한도를 우회할 수 있기 때문이다.
      // 실제 계정 삭제는 deleteUserAccount 함수(recursiveDelete)가 처리한다.
      allow delete: if false;

      // ⚠️ `match /{document=**}` 로 쓰면 하위 문서뿐 아니라
      // users/{userId} 문서 자신에게도 매칭돼서, 바로 위의 필드 보호가
      // 통째로 무력화된다(Rules Test API로 확인함).
      // 컬렉션 세그먼트를 하나 강제해서 "하위 데이터만" 걸리게 한다.
      match /{collection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── 앱 공용 설정 (읽기 전용) ────────────────────────────
    // config/limits = 무료 사용 한도. 서버(callGemini)가 차단에 쓰고
    // 앱은 잔여 횟수 표시에 쓴다. 양쪽이 같은 문서를 보기 때문에
    // 콘솔에서 숫자만 바꾸면 앱 업데이트 없이 즉시 반영된다.
    //
    // 쓰기는 절대 열지 않는다. 클라이언트가 한도를 고칠 수 있으면
    // 그 순간 한도가 아니다 (Admin SDK는 규칙을 우회하므로 운영은 콘솔에서).
    match /config/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════
    // ⚠️ 이 블록은 MyNexus 앱 기능이 아닙니다.
    //    '모두의 창업' 지원용 한시적 고객검증 설문 (별도 프로젝트)
    //    · 설문 페이지 소스 : C:\project\modoo\web\survey\
    //    · 배포처          : https://mynexus-survey.web.app (별도 호스팅 사이트)
    //    · 앱 코드·앱 데이터 경로와 무관합니다
    //
    //    🗑 제거 방법 (2026-09-18 이후, MyNexus 프로젝트에서 직접):
    //       이 주석부터 아래 match 블록 끝까지 삭제 후
    //       firebase deploy --only firestore:rules
    //
    //    ※ modoo(컨설팅) 프로젝트는 2026-09-09 이후 이 파일을 수정하지 않습니다.
    //      설문 문항이 바뀌어도 규칙은 그대로여야 하므로, 아래 검증은
    //      **문항 필드에 의존하지 않는 형태**로 작성했습니다.
    // ══════════════════════════════════════════════════════════
    match /survey_responses/{docId} {
      // 문항 구조와 무관한 최소 계약만 검사한다.
      //  · createdAt 은 반드시 서버 시각    → 클라이언트가 시각을 위조할 수 없다
      //  · source 는 짧은 문자열           → 유입 채널 표시 (자유 문자열 주입 방지)
      //  · 필드 개수 상한                  → 문서가 무한정 넓어지는 것을 막는다
      // 필드 이름·타입을 나열하지 않으므로 설문 문항을 바꿔도 이 파일은 그대로 둔다.
      // 대신 화이트리스트가 없어 임의 필드가 들어올 수 있는데, 이 컬렉션은
      // 읽기가 완전히 막혀 있고 create 전용이라 최악의 경우가 '쓰레기 행 유입'이며
      // 집계 단계에서 걸러진다. (수정·삭제는 어떤 경우에도 불가)
      function validSurvey() {
        let d = request.resource.data;
        return d.createdAt == request.time
            && d.source is string && d.source.size() <= 20
            && d.keys().size() <= 15;
      }
      allow read: if request.auth != null
                  && request.auth.token.email == 'cine1052rene@gmail.com';
      allow create: if validSurvey();
      allow update, delete: if false;
    }

    // ── 그 외 전부 차단 ────────────────────────────────────
    // 구 전역 컬렉션(/links, /events, ...)도 여기에 걸려 접근 불가.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
